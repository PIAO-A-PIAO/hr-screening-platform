{
  "name": "ds-hr",
  "private": true,
  "version": "0.0.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/concurrently/dist/bin/concurrently.js -n api,web -c blue,green \"npm run dev -w @ds-hr/api\" \"npm run dev -w @ds-hr/web\"",
    "build": "npm run db:generate && npm run build -w @ds-hr/api && npm run build -w @ds-hr/web",
    "test": "npm run test -w @ds-hr/api",
    "lint": "eslint \"apps/**/*.{ts,tsx,js}\" --max-warnings=0",
    "typecheck": "npm run typecheck -w @ds-hr/api && npm run typecheck -w @ds-hr/web",
    "verify": "npm run db:generate && npm run lint && npm run typecheck && npm test && npm run build",
    "db:generate": "npm run generate -w @ds-hr/database",
    "db:validate": "node --env-file-if-exists=.env ./node_modules/prisma/build/index.js validate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "node --env-file-if-exists=.env ./node_modules/prisma/build/index.js migrate dev --schema packages/database/prisma/schema.prisma",
    "db:deploy": "node --env-file-if-exists=.env ./node_modules/prisma/build/index.js migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:studio": "node --env-file-if-exists=.env ./node_modules/prisma/build/index.js studio --schema packages/database/prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "typescript-eslint": "^8.46.4"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}
