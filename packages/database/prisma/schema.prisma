generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuestionType {
  VIDEO
  MULTIPLE_CHOICE
  SHORT_ANSWER
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionAssetKind {
  VIDEO
  THUMBNAIL
}

enum VideoProcessingStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  ABANDONED
}

enum AttemptScoreState {
  PENDING
  PARTIAL
  FINAL
}

enum PositionStatus {
  OPEN
  CLOSED
}

enum InterviewWorkflowStatus {
  INVITED
  TO_EVALUATE
  PHASE_1
  PHASE_2
  PHASE_3
  DISCARDED
}

enum EmailDelayUnit {
  MINUTES
  HOURS
  DAYS
}

enum EmailSequenceTrigger {
  INVITATION
  NO_RESPONSE
  INTERVIEW_COMPLETED
}

enum EmailSequenceStopCondition {
  CANDIDATE_SUBMITTED
  CANDIDATE_DISCARDED
  POSITION_CLOSED
}

enum EmailTaskStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum UserRole {
  RECRUITER
  CANDIDATE
}

enum UserTestStatus {
  NOT_INVITED
  INVITED
  TO_BE_EVALUATED
  STAGE_1
  STAGE_2
  STAGE_3
  SHORTLISTED
  DISCARDED
  HIRED
  ON_HOLD
}

enum ResponseType {
  VIDEO
  MULTIPLE_CHOICE
  SHORT_ANSWER
}

model User {
  id         String    @id @default(cuid())
  name       String
  email      String    @unique
  role       UserRole
  status     UserTestStatus[] @default([])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  createdTests     Test[]     @relation("TestCreator")
  createdQuestions Question[] @relation("QuestionCreator")
  evaluatedResponses Response[] @relation("ResponseEvaluator")
  departments      Department[]
}

model Candidate {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviews Interview[]
  attempts   Attempt[]
  responses  Response[] @relation("CandidateResponses")
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  positions Position[]
  users     User[]
}

model Test {
  id               String     @id @default(cuid())
  name             String
  description      String?
  positionMetadata Json?
  positionId       String?    @unique
  tags             String[]   @default([])
  status           TestStatus @default(DRAFT)
  creatorId        String?
  creatorName      String?
  creator          User?      @relation("TestCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  position         Position?  @relation(fields: [positionId], references: [id], onDelete: SetNull)
  configuration    Json?
  questions        Question[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  interviews       Interview[]
  attempts         Attempt[]
  responses        Response[]
}

model Position {
  id          String         @id @default(cuid())
  title       String
  tags        String[]       @default([])
  status      PositionStatus @default(OPEN)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  departments Department[]
  interviews  Interview[]
  test        Test?
  emails      EmailSequence?
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  subject   String
  html      String
  text      String?
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps EmailSequenceStep[]
  tasks EmailTask[]
}

model EmailSettings {
  id                    Int     @id @default(1)
  smtpHost              String?
  smtpPort              Int     @default(587)
  smtpSecure            Boolean @default(false)
  smtpUser              String?
  smtpPasswordEncrypted String?
  emailFrom             String?
  updatedAt             DateTime @updatedAt
}

model EmailTask {
  id                String              @id @default(cuid())
  interviewId       String              @map("assignmentId")
  templateId        String
  sequenceStepOrder Int
  dueAt             DateTime
  to                String
  subject           String
  html              String
  text              String?
  variables         Json
  status            EmailTaskStatus     @default(PENDING)
  attemptCount      Int                 @default(0)
  lastError         String?
  idempotencyKey    String              @unique
  stopCondition     EmailSequenceStopCondition?
  sentAt            DateTime?
  processedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  interview Interview     @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  template  EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([status, dueAt])
  @@index([interviewId, sequenceStepOrder])
  @@index([templateId])
}

model EmailSequence {
  id         String               @id @default(cuid())
  positionId String               @unique
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  steps    EmailSequenceStep[]
}

model EmailSequenceStep {
  id              String                     @id @default(cuid())
  sequenceId      String
  templateId      String
  delayValue      Int
  delayUnit       EmailDelayUnit
  order           Int
  trigger         EmailSequenceTrigger       @default(NO_RESPONSE)
  stopCondition   EmailSequenceStopCondition?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  sequence EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  template EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([sequenceId, order])
  @@index([sequenceId])
  @@index([sequenceId, trigger])
  @@index([templateId])
}

model Question {
  id          String         @id @default(cuid())
  title       String
  description String?
  type        QuestionType
  order       Int            @default(0)
  testId      String?
  test        Test?          @relation(fields: [testId], references: [id], onDelete: SetNull)
  status      QuestionStatus  @default(DRAFT)
  creatorId   String?
  creatorName String?
  creator     User?          @relation("QuestionCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  videoItem          VideoQuestionItem?
  multipleChoiceItem MultipleChoiceQuestionItem?
  shortAnswerItem    ShortAnswerQuestionItem?
  responses          Response[]

  @@index([testId, order])
  @@index([type])
}

model Interview {
  id             String                  @id @default(cuid())
  candidateId    String                  @map("userId")
  positionId     String
  testId         String
  workflowStatus InterviewWorkflowStatus @default(INVITED)
  inviteToken    String?                 @unique
  invitedAt      DateTime                @default(now())
  inviteExpiresAt DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  candidate        Candidate               @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  position         Position                @relation(fields: [positionId], references: [id], onDelete: Cascade)
  test             Test                    @relation(fields: [testId], references: [id], onDelete: Cascade)
  attempt          Attempt?
  emailTasks       EmailTask[]
  workflowRevision Int                     @default(0) @map("stageRevision")
  statusChanges    InterviewStatusChange[]

  @@unique([candidateId, positionId])
  @@index([positionId, workflowStatus])
  @@index([testId])
  @@index([candidateId])
  @@map("UserTestAssignment")
}

model Attempt {
  id            String            @id @default(cuid())
  interviewId    String            @unique @map("assignmentId")
  testId         String
  candidateId    String            @map("userId")
  status         AttemptStatus     @default(IN_PROGRESS)
  startedAt      DateTime          @default(now())
  submittedAt    DateTime?
  scoreSum       Float?
  scoreState     AttemptScoreState @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  test      Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  responses Response[]

  @@unique([candidateId, testId])
  @@index([testId])
  @@index([candidateId])
}

model VideoQuestionItem {
  questionId       String   @id
  question         Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  videoAssetId     String?  @unique
  videoAsset       QuestionAsset? @relation("QuestionVideoAsset", fields: [videoAssetId], references: [id], onDelete: SetNull)
  thumbnailAssetId String?  @unique
  thumbnailAsset   QuestionAsset? @relation("QuestionThumbnailAsset", fields: [thumbnailAssetId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  processingJobs VideoProcessingJob[]
}

model VideoProcessingJob {
  id String @id @default(cuid())
  questionId String
  question VideoQuestionItem @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  sourceAssetId String
  previousAssetId String?
  status VideoProcessingStatus @default(PENDING)
  attempts Int @default(0)
  lastError String?
  nextAttemptAt DateTime @default(now())
  processedAssetId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([questionId, createdAt])
}

model MultipleChoiceQuestionItem {
  questionId             String   @id
  question               Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  allowMultipleSelection Boolean  @default(false)
  shuffleOptions         Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  options MultipleChoiceQuestionOption[]
}

model MultipleChoiceQuestionOption {
  id          String   @id @default(cuid())
  questionId   String
  question     MultipleChoiceQuestionItem @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  label        String
  value        String
  order        Int
  isCorrect    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  selectedInResponses MultipleChoiceResponseSelection[]

  @@index([questionId, order])
}

model ShortAnswerQuestionItem {
  questionId  String   @id
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  placeholder String?
  maxLength   Int?
  answerHint  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

}

model QuestionAsset {
  id             String          @id @default(cuid())
  kind           QuestionAssetKind
  storageKey     String          @unique
  mimeType       String
  size           Int
  durationSeconds Float?
  checksum       String
  ownerId        String?
  originalName   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  videoQuestionItemForVideo     VideoQuestionItem? @relation("QuestionVideoAsset")
  videoQuestionItemForThumbnail  VideoQuestionItem? @relation("QuestionThumbnailAsset")

  @@index([kind])
}

model Response {
  id              String       @id @default(cuid())
  type            ResponseType
  questionId      String
  candidateId     String       @map("userId")
  testId          String
  attemptId       String?
  score           Float?
  evaluatorComment String?
  evaluatorUserId String?
  evaluatedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  question  Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  candidate Candidate @relation("CandidateResponses", fields: [candidateId], references: [id], onDelete: Cascade)
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  attempt   Attempt?  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  evaluator User?    @relation("ResponseEvaluator", fields: [evaluatorUserId], references: [id], onDelete: SetNull)

  videoItem          VideoResponseItem?
  multipleChoiceItem MultipleChoiceResponseItem?
  shortAnswerItem    ShortAnswerResponseItem?

  @@unique([candidateId, testId, questionId])
  @@index([testId, candidateId])
  @@index([questionId])
  @@index([attemptId])
}

model VideoResponseItem {
  responseId String   @id
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  assetId    String?  @unique
  asset      ResponseAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MultipleChoiceResponseItem {
  responseId String   @id
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  selections MultipleChoiceResponseSelection[]
}

model MultipleChoiceResponseSelection {
  responseId String
  optionId   String
  response   MultipleChoiceResponseItem @relation(fields: [responseId], references: [responseId], onDelete: Cascade)
  option     MultipleChoiceQuestionOption @relation(fields: [optionId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@id([responseId, optionId])
  @@index([optionId])
}

model ShortAnswerResponseItem {
  responseId String   @id
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  textValue  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ResponseAsset {
  id              String   @id @default(cuid())
  storageKey      String   @unique
  mimeType        String
  size            Int
  durationSeconds Float?
  checksum        String
  ownerId         String
  originalName    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  videoResponseItem VideoResponseItem?

  @@index([ownerId])
}


model InterviewStatusChange {
  id String @id @default(cuid())
  interviewId String? @map("assignmentId")
  positionId String
  candidateId String
  fromStatus InterviewWorkflowStatus @map("fromStage")
  toStatus InterviewWorkflowStatus @map("toStage")
  actorId String
  actorName String
  changedAt DateTime @default(now())
  interview Interview? @relation(fields: [interviewId], references: [id], onDelete: SetNull)

  @@index([interviewId, changedAt])
  @@index([positionId, changedAt])
  @@map("CandidateStageChange")
}
