generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuestionType {
  VIDEO
  MULTIPLE_CHOICE
  SHORT_ANSWER
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionAssetKind {
  VIDEO
  THUMBNAIL
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PositionStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
}

enum UserRole {
  RECRUITER
  CANDIDATE
}

enum UserTestStatus {
  NOT_INVITED
  INVITED
  TO_BE_EVALUATED
  STAGE_1
  STAGE_2
  STAGE_3
  SHORTLISTED
  DISCARDED
  HIRED
  ON_HOLD
}

model User {
  id         String    @id @default(cuid())
  name       String
  email      String    @unique
  role       UserRole
  status     UserTestStatus[] @default([])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  createdTests     Test[]     @relation("TestCreator")
  createdQuestions Question[] @relation("QuestionCreator")
  testAssignments  UserTestAssignment[]
}

model Test {
  id               String     @id @default(cuid())
  name             String
  description      String?
  positionMetadata Json?
  positionId       String?    @unique
  tags             String[]   @default([])
  status           TestStatus @default(DRAFT)
  creatorId        String?
  creatorName      String?
  creator          User?      @relation("TestCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  position         Position?  @relation(fields: [positionId], references: [id], onDelete: SetNull)
  configuration    Json?
  questions        Question[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  assignments      UserTestAssignment[]
}

model Position {
  id          String         @id @default(cuid())
  title       String
  description String?
  department  String
  location    String
  status      PositionStatus @default(DRAFT)
  owner       String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  test Test?
}

model Question {
  id          String         @id @default(cuid())
  title       String
  description String?
  type        QuestionType
  order       Int            @default(0)
  testId      String?
  test        Test?          @relation(fields: [testId], references: [id], onDelete: SetNull)
  status      QuestionStatus  @default(DRAFT)
  creatorId   String?
  creatorName String?
  creator     User?          @relation("QuestionCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  videoItem          VideoQuestionItem?
  multipleChoiceItem MultipleChoiceQuestionItem?
  shortAnswerItem    ShortAnswerQuestionItem?

  @@index([testId, order])
  @@index([type])
}

model UserTestAssignment {
  id        String        @id @default(cuid())
  userId    String
  testId    String
  status    UserTestStatus[] @default([])
  inviteToken String?     @unique
  invitedAt DateTime      @default(now())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([userId, testId])
  @@index([testId])
  @@index([userId])
}

model VideoQuestionItem {
  questionId       String   @id
  question         Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  videoAssetId     String?  @unique
  videoAsset       QuestionAsset? @relation("QuestionVideoAsset", fields: [videoAssetId], references: [id], onDelete: SetNull)
  thumbnailAssetId String?  @unique
  thumbnailAsset   QuestionAsset? @relation("QuestionThumbnailAsset", fields: [thumbnailAssetId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MultipleChoiceQuestionItem {
  questionId             String   @id
  question               Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  allowMultipleSelection Boolean  @default(false)
  shuffleOptions         Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  options MultipleChoiceQuestionOption[]
}

model MultipleChoiceQuestionOption {
  id          String   @id @default(cuid())
  questionId   String
  question     MultipleChoiceQuestionItem @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  label        String
  value        String
  order        Int
  isCorrect    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([questionId, order])
}

model ShortAnswerQuestionItem {
  questionId  String   @id
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  placeholder String?
  maxLength   Int?
  answerHint  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QuestionAsset {
  id             String          @id @default(cuid())
  kind           QuestionAssetKind
  storageKey     String          @unique
  mimeType       String
  size           Int
  durationSeconds Float?
  checksum       String
  ownerId        String?
  originalName   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  videoQuestionItemForVideo     VideoQuestionItem? @relation("QuestionVideoAsset")
  videoQuestionItemForThumbnail  VideoQuestionItem? @relation("QuestionThumbnailAsset")

  @@index([kind])
}
